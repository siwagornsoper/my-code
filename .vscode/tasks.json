{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "intensive programming",
            "type": "shell",
            "command": "/opt/homebrew/bin/gcc-15",
            "args": [
                "-std=c89",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Werror",
                "-pedantic-errors",
                "-g",
                "-gdwarf-4",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}